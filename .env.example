# Copy this file to .env and fill in the values for local development.
# Do NOT commit your real secrets to the repository.

# Azure / MSAL configuration
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
TENANT_ID=your-tenant-id
# Optionally you can set AUTHORITY directly, e.g.
# AUTHORITY=https://login.microsoftonline.com/<tenant>

# Signs the Flask session cookie that grants access to the docs.
# The server refuses to start without this. Generate a fresh random
# value per environment and never reuse one across deployments.
SECRET_KEY=a-very-secret-dev-key

# Set to true when you serve over HTTPS so the session cookie is
# only sent on secure connections.
SESSION_COOKIE_SECURE=false
