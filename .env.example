# Copy this file to .env and fill in the values for local development.
# Do NOT commit your real secrets to the repository.

# Azure / MSAL configuration
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
TENANT_ID=your-tenant-id
# Optionally you can set AUTHORITY directly, e.g.
# AUTHORITY=https://login.microsoftonline.com/<tenant>

# Server signing key for tokens (change in production)
SECRET_KEY=a-very-secret-dev-key

# Token lifetime in seconds (default 3600)
TOKEN_EXPIRES_SECONDS=3600
